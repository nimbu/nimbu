#!/usr/bin/env ruby

# resolve bin path, ignoring symlinks
require "pathname"
bin_file = Pathname.new(__FILE__).realpath

# add self to libpath
$:.unshift File.expand_path("../../lib", bin_file)

warn "[DEPRECATED] The nimbu gem is no longer maintained. Use the Nimbu Go CLI: brew install nimbu/tap/nimbu (https://github.com/nimbu/cli)"

# start up the CLI
require "nimbu/cli"
Nimbu::CLI.start(*ARGV)
